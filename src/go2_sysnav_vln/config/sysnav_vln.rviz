Panels:
- Class: rviz_common/Displays
  Help Height: 78
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Status1
    - /TF1
    - /Maps1
    - /Navigation1
    - /SysNav VLN1
    - /Camera Overlay1
    Splitter Ratio: 0.5
  Tree Height: 750
- Class: rviz_common/Selection
  Name: Selection
- Class: rviz_common/Tool Properties
  Expanded:
  - /2D Goal Pose1
  Name: Tool Properties
  Splitter Ratio: 0.588679016
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Enabled: true
    Name: Grid
    Cell Size: 1
    Color: 160; 160; 164
    Line Style:
      Line Width: 0.03
      Value: Lines
    Plane: XY
    Plane Cell Count: 30
    Reference Frame: <Fixed Frame>
  - Class: rviz_default_plugins/TF
    Enabled: true
    Name: TF
    Frame Timeout: 15
    Show Arrows: true
    Show Axes: true
    Show Names: false
    Update Interval: 0
    Marker Scale: 0.35
  - Class: rviz_common/Group
    Enabled: true
    Name: Maps
    Displays:
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: SLAM Map /map
      Alpha: 0.72
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Update Topic: ''
    - Class: rviz_default_plugins/Map
      Enabled: false
      Name: Padded Map /map_padded
      Alpha: 0.35
      Color Scheme: map
      Draw Behind: false
      Topic:
        Value: /map_padded
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Update Topic: ''
    - Class: rviz_default_plugins/Map
      Enabled: false
      Name: Global Costmap
      Alpha: 0.35
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Value: /global_costmap/costmap
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Update Topic: ''
    - Class: rviz_default_plugins/Map
      Enabled: false
      Name: Local Costmap
      Alpha: 0.45
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Value: /local_costmap/costmap
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Update Topic: ''
  - Class: rviz_common/Group
    Enabled: true
    Name: Navigation
    Displays:
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Nav2 Plan /plan
      Buffer Length: 1
      Line Style: Lines
      Line Width: 0.07
      Offset:
        X: 0
        Y: 0
        Z: 0.05
      Pose Color: 255; 85; 255
      Pose Style: None
      Topic:
        Value: /plan
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
    - Class: rviz_default_plugins/PoseArray
      Enabled: false
      Name: Particle Cloud /particle_cloud
      Alpha: 0.5
      Arrow Length: 0.3
      Axes Length: 0.3
      Axes Radius: 0.01
      Color: 255; 25; 0
      Shaft Length: 0.1
      Shape: Arrow
      Topic:
        Value: /particle_cloud
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
  - Class: rviz_common/Group
    Enabled: true
    Name: Robot Sensors
    Displays:
    - Class: rviz_default_plugins/LaserScan
      Enabled: false
      Name: Navigation LaserScan /scan_nav
      Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Color: 255; 0; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.04
      Style: Points
      Topic:
        Value: /scan_nav
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
      Use Fixed Frame: true
      Use rainbow: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: PointCloud2 /point_cloud2
      Alpha: 0.55
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Color: 255; 255; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.03
      Style: Points
      Topic:
        Value: /point_cloud2
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
      Use Fixed Frame: true
      Use rainbow: true
  - Class: rviz_common/Group
    Enabled: true
    Name: SysNav VLN
    Displays:
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Confirmed Object Points
      Namespaces: {}
      Topic:
        Value: /go2_vln/object_markers
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Frontier Boundaries and Safe Goals
      Namespaces: {}
      Topic:
        Value: /go2_vln/frontier_markers
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Room Labels
      Namespaces: {}
      Topic:
        Value: /go2_vln/room_markers
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
  - Class: rviz_common/Group
    Enabled: false
    Name: Legacy Object Explorer
    Displays:
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Legacy Explorer Markers
      Namespaces: {}
      Topic:
        Value: /object_explorer/markers
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Legacy Detection Markers
      Namespaces: {}
      Topic:
        Value: /object_explorer/detection_markers
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Legacy Frontier Markers
      Namespaces: {}
      Topic:
        Value: /object_explorer/frontiers
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
  - Class: rviz_common/Group
    Enabled: true
    Name: Camera Overlay
    Displays:
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: YOLO SAM2 Annotated Image
      Normalize Range: true
      Max Value: 1
      Min Value: 0
      Median window: 5
      Topic:
        Value: /object_explorer/annotated_image
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Transport Hint: raw
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  - Class: rviz_default_plugins/SetInitialPose
    Topic:
      Value: /initialpose
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 10
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Value: /goal_pose
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 10
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.56
      Target Frame: map
      Value: Orbit
      Yaw: 3.14
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Height: 1000
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Selection:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1600
  X: 50
  Y: 50
